# Copy to .env (never committed) and fill in the secrets.

# --- Database (compose.yaml) ---
POSTGRES_DB=ats
POSTGRES_USER=ats
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5433   # 5432 is often taken by a native PostgreSQL
# Used by the API, the Worker, and EF Core migrations when they run on the host.
ConnectionStrings__Ats=Host=localhost;Port=5433;Database=ats;Username=ats;Password=change-me

# --- Access tokens (AD-06): HS256 signing key, at least 32 bytes. Generate one per environment.
Jwt__SigningKey=change-me-to-a-random-secret-of-32-bytes-or-more

# --- First Admin, created by `migrate` while no Admin exists (docs/07-database-design.md, seed data) ---
# Password: 10–128 characters.
Seed__AdminEmail=admin@example.test
Seed__AdminPassword=change-me-please

# --- Demo data, only with `migrate --demo` (local development; refused in Production) ---
# Password of every demo account (thu.ha@demo.test, minh.anh@demo.test, ...): 10–128 characters.
Seed__DemoPassword=change-me-demo

# --- AI (docs/09-folder-structure.md §7.1). Fake needs no key. ---
Ai__Provider=Fake
# Ai__Provider=OpenAICompatible
# Ai__BaseUrl=https://api.deepseek.com
# Ai__Model=<model id from DeepSeek docs>
# Ai__ApiKey=<secret>
# Ai__ResponseFormat=JsonObject
AiEmbedding__Provider=Fake
# AiEmbedding__Provider=OpenAICompatible
# AiEmbedding__BaseUrl=https://api.openai.com/v1
# AiEmbedding__Model=text-embedding-3-small
# AiEmbedding__ApiKey=<secret>
AiEmbedding__Dimensions=1024
