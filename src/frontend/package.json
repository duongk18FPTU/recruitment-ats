{
  "name": "recruitment-ats-frontend",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "generate": "npm run generate -w @ats/api-client",
    "typecheck": "tsc -p packages/api-client && tsc -p packages/ui",
    "lint": "eslint .",
    "test": "vitest run",
    "build": "npm run build -w @ats/internal -w @ats/career",
    "dev:internal": "npm run dev -w @ats/internal",
    "dev:career": "npm run dev -w @ats/career"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "jsdom": "30.1.3",
    "msw": "3.0.3",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
